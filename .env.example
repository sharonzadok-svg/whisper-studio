# Subtitle Studio Environment Variables
# Copy this file to .env and configure as needed
# NOTE: Keep .env out of git (it's in .gitignore)

# Hugging Face API Token (optional - use huggingface-cli login instead)
# HF_TOKEN=hf_your_token_here

# FFmpeg binary path (optional - auto-detected if in PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Model directory (optional - defaults to ./models)
# MODELS_DIR=./models

# Debug logging (0=off, 1=on)
# DEBUG=0

# Application configuration (optional)
# DEFAULT_FONT=Arial
# DEFAULT_FONT_SIZE=24
# DEFAULT_PLACEMENT=Bottom
